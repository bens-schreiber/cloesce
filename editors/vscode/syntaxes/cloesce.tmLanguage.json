{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cloesce",
  "scopeName": "source.cloesce",
  "fileTypes": [
    "cloesce",
    "clo"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#tag"
    },
    {
      "include": "#string"
    },
    {
      "include": "#regex-literal"
    },
    {
      "include": "#number"
    },
    {
      "include": "#self-keyword"
    },
    {
      "include": "#block-declaration"
    },
    {
      "include": "#http-verb"
    },
    {
      "include": "#crud-method"
    },
    {
      "include": "#structural-keyword"
    },
    {
      "include": "#generic-type"
    },
    {
      "include": "#builtin-type"
    },
    {
      "include": "#arrow"
    },
    {
      "include": "#double-colon"
    },
    {
      "include": "#pascal-snake-case"
    },
    {
      "include": "#screaming-snake-case"
    },
    {
      "include": "#pascal-case"
    },
    {
      "include": "#identifier"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.cloesce",
      "match": "//.*$"
    },
    "string": {
      "name": "string.quoted.double.cloesce",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "variable.other.interpolation.cloesce",
          "match": "\\{[a-zA-Z_][a-zA-Z0-9_]*\\}"
        },
        {
          "name": "constant.character.escape.cloesce",
          "match": "\\\\."
        }
      ]
    },
    "regex-literal": {
      "name": "string.regexp.cloesce",
      "begin": "/(?=[^/\\n])",
      "end": "/",
      "patterns": [
        {
          "name": "constant.character.escape.cloesce",
          "match": "\\\\."
        }
      ]
    },
    "number": {
      "name": "constant.numeric.cloesce",
      "match": "\\b-?[0-9]+(?:\\.[0-9]+)?\\b"
    },
    "arrow": {
      "name": "keyword.operator.arrow.cloesce",
      "match": "->"
    },
    "double-colon": {
      "name": "keyword.operator.namespace.cloesce",
      "match": "::"
    },
    "self-keyword": {
      "name": "variable.language.self.cloesce",
      "match": "\\bself\\b"
    },
    "block-declaration": {
      "comment": "Top-level block keywords",
      "name": "keyword.declaration.cloesce",
      "match": "\\b(model|poo|source|inject|api|var|d1|r2|kv|durable)\\b"
    },
    "http-verb": {
      "comment": "HTTP verbs used to introduce an API method",
      "name": "keyword.control.http.cloesce",
      "match": "\\b(get|post|put|patch|delete)\\b"
    },
    "crud-method": {
      "comment": "Data source method kinds",
      "name": "keyword.control.crud.cloesce",
      "match": "\\b(list|save)\\b"
    },
    "structural-keyword": {
      "comment": "Block/sub-block keywords used by the parser",
      "name": "keyword.other.cloesce",
      "match": "\\b(primary|route|column|foreign|one|many|shard|include|for|crud|internal|instance|header|unique|lt|lte|gt|gte|step|len|minlen|maxlen|regex)\\b"
    },
    "builtin-type": {
      "name": "support.type.primitive.cloesce",
      "match": "\\b(string|int|real|date|bool|json|blob|stream|r2object)\\b"
    },
    "generic-type": {
      "name": "support.type.generic.cloesce",
      "match": "\\b(option|array|kvobject|partial)\\b"
    },
    "pascal-snake-case": {
      "comment": "Pascal_Snake_Case — HTTP header identifiers in an API block",
      "name": "entity.name.tag.header.cloesce",
      "match": "\\b(?=[A-Za-z0-9]*[a-z])[A-Z][a-zA-Z0-9]*(?:_[A-Z][a-zA-Z0-9]*)+\\b"
    },
    "screaming-snake-case": {
      "comment": "SCREAMING_SNAKE_CASE — variables declared in a var block",
      "name": "variable.other.constant.cloesce",
      "match": "\\b[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+\\b"
    },
    "pascal-case": {
      "comment": "PascalCase — Models, Data Sources, POOs, Databases (D1/R2/Durable Objects), Inject identifiers",
      "name": "entity.name.type.cloesce",
      "match": "\\b[A-Z][a-zA-Z0-9]*\\b"
    },
    "identifier": {
      "comment": "snake_case or camelCase — fields, parameters, and other bindings",
      "name": "variable.other.cloesce",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    },
    "tag": {
      "comment": "Anything wrapped in [ ... ] — picks up tag keyword via inner patterns",
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.tag.begin.cloesce"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.tag.end.cloesce"
        }
      },
      "patterns": [
        {
          "include": "#string"
        },
        {
          "include": "#regex-literal"
        },
        {
          "include": "#number"
        },
        {
          "comment": "Tag-leading keywords not otherwise covered",
          "name": "keyword.other.cloesce",
          "match": "\\b(inject|source)\\b"
        },
        {
          "include": "#structural-keyword"
        },
        {
          "include": "#crud-method"
        },
        {
          "include": "#http-verb"
        },
        {
          "include": "#pascal-case"
        },
        {
          "name": "variable.other.cloesce",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "punctuation.separator.comma.cloesce",
          "match": ","
        }
      ]
    }
  }
}
