//! This file defines environment bindings and custom dependency injection for the Cloesce schema.
//
//! Note that every top level symbol in Cloesce is global across all files as of alpha v0.6.0

// The primary Cloudflare D1 database this application will be using.
d1 { Db }

// A value that can be injected into API methods.
// Cloesce will stub it out such that we can implement what this value holds,
// which will a reference to the current authenticated user, if any.
inject { Auth }