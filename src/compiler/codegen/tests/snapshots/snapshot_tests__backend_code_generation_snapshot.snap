/**
 * The fully-upgraded Cloesce environment. Contains:
 * - every binding (e.g. `env.SubRedditDb`) and injectable, under its declared name
 * - each binding carrying its model stores
 * - each unbacked model's store, directly (e.g. `env.Foo` for a model with no D1/DO binding)
 *
 * Every binding keeps its declared `wrangler.toml` name; the raw `CfEnv` entry is replaced by
 * the upgraded handle (see the {@link Env} namespace), leaving Cloesce's own vars/injectables
 * intact.
 */
export interface Env extends Omit<CfEnv, never | "db" | "MyKv" | "MyR2" | "GlobalDo" | "LeaderboardDo"> {
    RouteCar: RouteCarStore<Env.AllBindings>;
    RouteOwner: RouteOwnerStore<Env.AllBindings>;
    db: Env.db;
    MyKv: Env.MyKv;
    MyR2: Env.MyR2;
    GlobalDo: Env.GlobalDo;
    LeaderboardDo: Env.LeaderboardDo;
    YouTubeApi: YouTubeApi;
}

export namespace Env {
    export interface BasicServiceTopScores {
        LeaderboardDo: Env.LeaderboardDo<BasicServiceTopScores>;
        ctx: DurableObjectState;
    }
    export interface BasicServiceGlobalConfig {
        GlobalDo: Env.GlobalDo<BasicServiceGlobalConfig>;
        ctx: DurableObjectState;
    }
    export interface ModelWithCompositePkInstanceMethod {
        db: Env.db<ModelWithCompositePkInstanceMethod>;
    }
    export interface ModelWithKvInstanceMethod {
        db: Env.db<ModelWithKvInstanceMethod>;
    }
}

export namespace Api {
    export namespace BasicService {
        export type downloadData = () => Awaitable<HttpResult<ReadableStream> | ReadableStream>;
        export type instanceMethod = (input: number) => Awaitable<HttpResult<number> | number>;
        export type staticMethod = (input: string, Authorization: string) => Awaitable<HttpResult<string> | string>;
        export type uploadData = (data: ReadableStream) => Awaitable<HttpResult<boolean> | boolean>;
        export type topScores = (env: Env.BasicServiceTopScores, tenantId: number) => Awaitable<HttpResult<unknown> | unknown>;
        export type globalConfig = (env: Env.BasicServiceGlobalConfig) => Awaitable<HttpResult<unknown> | unknown>;
        export type Of = { downloadData: downloadData; instanceMethod: instanceMethod; staticMethod: staticMethod; uploadData: uploadData; topScores: topScores; globalConfig: globalConfig };
    }
    export namespace GlobalSettings {
        export type Of = {  };
    }
    export namespace HasSqlColumnTypes {
        export type Of = {  };
    }
    export namespace Leaderboard {
        export type Of = {  };
    }
    export namespace LeaderboardEntry {
        export type Of = {  };
    }
    export namespace ModelWithCompositePk {
        export type instanceMethod = (self: ModelWithCompositePk, env: Env.ModelWithCompositePkInstanceMethod, input: string) => Awaitable<HttpResult<string> | string>;
        export type Of = { instanceMethod: instanceMethod };
    }
    export namespace ModelWithKv {
        export type instanceMethod = (self: ModelWithKv, env: Env.ModelWithKvInstanceMethod, input: string) => Awaitable<HttpResult<string> | string>;
        export type staticMethod = (input: number) => Awaitable<HttpResult<number> | number>;
        export type hasKvParamAndRes = (self: ModelWithKv, input: KValue<string>) => Awaitable<HttpResult<KValue<string>> | KValue<string>>;
        export type Of = { instanceMethod: instanceMethod; staticMethod: staticMethod; hasKvParamAndRes: hasKvParamAndRes };
    }
    export namespace ModelWithR2 {
        export type hasR2ParamAndRes = (self: ModelWithR2, input: R2ObjectBody) => Awaitable<HttpResult<R2ObjectBody> | R2ObjectBody>;
        export type Of = { hasR2ParamAndRes: hasR2ParamAndRes };
    }
    export namespace OneToManyModel {
        export type Of = {  };
    }
    export namespace RouteCar {
        export type Of = {  };
    }
    export namespace RouteOwner {
        export type instanceMethod = (self: RouteOwner, input: string) => Awaitable<HttpResult<string> | string>;
        export type Of = { instanceMethod: instanceMethod };
    }
    export namespace ToyotaPrius {
        export type instanceMethod = (self: ToyotaPrius, input: string) => Awaitable<HttpResult<string> | string>;
        export type Of = { instanceMethod: instanceMethod };
    }
    export namespace BasicModel {
        export type Of = {  };
    }
    export namespace ModelWithCustomDs {
        export type instanceMethod = (self: ModelWithCustomDs, input: string) => Awaitable<HttpResult<string> | string>;
        export interface Custom {
            get(id: number, externalParam: string): Promise<HttpResult<ModelWithCustomDs>>;
        }
        export type Of = { instanceMethod: instanceMethod; Custom: Custom };
    }
    export namespace HasOneToOne {
        export type Of = {  };
    }
    export namespace ModelWithCruds {
        export interface ByName {
            get(name: string): Promise<HttpResult<ModelWithCruds>>;
            list(name: string, limit: number): Promise<HttpResult<ModelWithCruds[]>>;
        }
        export type Of = { ByName: ByName };
    }
}
export const BasicService: ModelTag<"BasicService", Api.BasicService.Of> = modelTag("BasicService");
export const GlobalSettings: ModelTag<"GlobalSettings", Api.GlobalSettings.Of> = modelTag("GlobalSettings");
export const HasSqlColumnTypes: ModelTag<"HasSqlColumnTypes", Api.HasSqlColumnTypes.Of> = modelTag("HasSqlColumnTypes");
export const Leaderboard: ModelTag<"Leaderboard", Api.Leaderboard.Of> = modelTag("Leaderboard");
export const LeaderboardEntry: ModelTag<"LeaderboardEntry", Api.LeaderboardEntry.Of> = modelTag("LeaderboardEntry");
export const ModelWithCompositePk: ModelTag<"ModelWithCompositePk", Api.ModelWithCompositePk.Of> = modelTag("ModelWithCompositePk");
export const ModelWithKv: ModelTag<"ModelWithKv", Api.ModelWithKv.Of> = modelTag("ModelWithKv");
export const ModelWithR2: ModelTag<"ModelWithR2", Api.ModelWithR2.Of> = modelTag("ModelWithR2");
export const OneToManyModel: ModelTag<"OneToManyModel", Api.OneToManyModel.Of> = modelTag("OneToManyModel");
export const RouteCar: ModelTag<"RouteCar", Api.RouteCar.Of> = modelTag("RouteCar");
export const RouteOwner: ModelTag<"RouteOwner", Api.RouteOwner.Of> = modelTag("RouteOwner");
export const ToyotaPrius: ModelTag<"ToyotaPrius", Api.ToyotaPrius.Of> = modelTag("ToyotaPrius");
export const BasicModel: ModelTag<"BasicModel", Api.BasicModel.Of> = modelTag("BasicModel");
export const ModelWithCustomDs: ModelTag<"ModelWithCustomDs", Api.ModelWithCustomDs.Of> = modelTag("ModelWithCustomDs");
export const HasOneToOne: ModelTag<"HasOneToOne", Api.HasOneToOne.Of> = modelTag("HasOneToOne");
export const ModelWithCruds: ModelTag<"ModelWithCruds", Api.ModelWithCruds.Of> = modelTag("ModelWithCruds");
/** Every model and injectable name. */
export type Owed = "BasicService" | "GlobalSettings" | "HasSqlColumnTypes" | "Leaderboard" | "LeaderboardEntry" | "ModelWithCompositePk" | "ModelWithKv" | "ModelWithR2" | "OneToManyModel" | "RouteCar" | "RouteOwner" | "ToyotaPrius" | "BasicModel" | "ModelWithCustomDs" | "HasOneToOne" | "ModelWithCruds";

/**
 * Build a Cloesce app, bind its source, then `register` its models and injectables and
 * `run(request)` (callable only once a source is bound and everything is registered).
 *
 * - **Worker:** `createApp().worker(env)`.
 * - **Durable Object:** `createApp().durable(this, [migrations])`, passing the DO instance itself.
 */
export function createApp(): AppBuilder<Owed, never, Env, CfEnv, DurableObject<CfEnv>> {
    return makeApp(cidl as any, "http://example.com/path/to/api", upgradeBindings) as unknown as AppBuilder<
        Owed,
        never,
        Env,
        CfEnv,
        DurableObject<CfEnv>
    >;
}
