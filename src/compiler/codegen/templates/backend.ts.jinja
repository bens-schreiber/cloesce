/**
 * Build a Cloesce app, bind its source, then `register` its models and injectables and
 * `run(request)` (callable only once a source is bound and everything is registered).
 *
 * - **Worker:** `createApp().worker(env)`.
 * - **Durable Object:** `createApp().durable(this, [migrations])`, passing the DO instance itself.
 */
export function createApp(): AppBuilder<Owed, never, Env, CfEnv, DurableObject<CfEnv>> {
    return makeApp(cidl as any, "{{ worker_url }}", upgradeBindings) as unknown as AppBuilder<
        Owed,
        never,
        Env,
        CfEnv,
        DurableObject<CfEnv>
    >;
}
